{
  // Opal Carindale site bookings: one Cloudflare Worker serving the app (public/, bundled at build) and the API (src/worker.js).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opal-bookings",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // The files in public/ are packed into the Worker by this build step (served by src/worker.js).
  "build": { "command": "node scripts/bundle-static.mjs", "watch_dir": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opal-bookings",
      "database_id": "996e2537-888c-433f-9e77-c41570d0004e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://opal-bookings.bradleriki.workers.dev",
    "MAIL_FROM": "Opal Carindale bookings <bookings@example.com>",
    "ADMIN_EMAILS": "",
    "DEV_MODE": "0"
  },
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY
  "triggers": { "crons": ["17 16 * * *"] },
  "observability": { "enabled": true }
}
